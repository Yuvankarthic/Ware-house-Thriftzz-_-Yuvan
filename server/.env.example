# ─── Database Connection (use cloud-hosted PostgreSQL) ───
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://username:password@host:5432/database
# ─── Server Port ───
PORT=4000

# ─── JWT Secret (for authentication) ───
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ─── Node Environment ───
NODE_ENV=production

# ─── Email (Order Confirmation) ───
# Preferred: API-based providers (works on Render)
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=your_verified_sender@example.com
MAIL_FROM_NAME=Wearhouse Thrift
MAIL_REPLY_TO=support@yourdomain.com

# Optional SMTP fallback (not recommended on Render)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_sender_email@gmail.com
SMTP_PASS=your_gmail_app_password
