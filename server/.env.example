# ─── Database Connection (use cloud-hosted PostgreSQL) ───
# For Railway: https://railway.app
# For Supabase: https://supabase.co
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:uhcfbpJzpyXRIDkJFpmKWsoOaLgDoStC@postgres.railway.internal:5432/railway
# ─── Server Port ───
PORT=4000

# ─── JWT Secret (for authentication) ───
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# ─── Node Environment ───
NODE_ENV=production

# ─── Email (Order Confirmation) ───
